<Application x:Class="ElectricalPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:utilities="clr-namespace:ElectricalPOS.Utilities"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MaterialDesignThemes - Primary Theme -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Arabic Font Family - Modern with excellent Arabic support -->
            <FontFamily x:Key="ArabicFont">Segoe UI, Tahoma, Arial, Traditional Arabic</FontFamily>

            <!-- ==================== Company Branding ==================== -->
            
            <!-- Company Name Constants -->
            <system:String x:Key="CompanyName">مركز الحاج حساني لتجارة الأدوات المنزلية الكهربائية</system:String>
            <system:String x:Key="CompanySubtitle">إدارة نبيل الحساني</system:String>

            <!-- ==================== Modern 2026 Color Palette ==================== -->
            <!-- Primary Colors - Deep Space Blue with Purple undertones -->
            <Color x:Key="PrimaryBusinessColor">#1A1A2E</Color>
            <Color x:Key="PrimaryLightColor">#2D2D44</Color>
            <Color x:Key="PrimaryDarkColor">#0F0F1A</Color>
            <Color x:Key="PrimaryHoverColor">#3D3D5C</Color>
            <Color x:Key="PrimaryAccentColor">#6C63FF</Color>
            
            <!-- Secondary Colors - Vibrant Teal/Cyan -->
            <Color x:Key="SecondaryBusinessColor">#00D9C0</Color>
            <Color x:Key="SecondaryLightColor">#33E3CF</Color>
            <Color x:Key="SecondaryDarkColor">#00B39E</Color>
            
            <!-- Accent Colors - Modern Coral/Salmon -->
            <Color x:Key="AccentBusinessColor">#FF6B6B</Color>
            <Color x:Key="AccentLightColor">#FF8A8A</Color>
            <Color x:Key="AccentDarkColor">#E84545</Color>
            
            <!-- Surface and Background Colors - Modern Light Theme -->
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="BackgroundColor">#F5F7FA</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="SidebarBackgroundColor">#1A1A2E</Color>
            <Color x:Key="SidebarGradientEndColor">#16213E</Color>
            <Color x:Key="SidebarAccentColor">#6C63FF</Color>
            
            <!-- Text Colors - Modern dark grays -->
            <Color x:Key="TextPrimaryColor">#1A1A2E</Color>
            <Color x:Key="TextSecondaryColor">#6B7280</Color>
            <Color x:Key="TextLightColor">#FFFFFF</Color>
            <Color x:Key="TextMutedColor">#9CA3AF</Color>
            
            <!-- Status Colors - Modern vivid colors -->
            <Color x:Key="SuccessColor">#10B981</Color>
            <Color x:Key="WarningColor">#F59E0B</Color>
            <Color x:Key="ErrorColor">#EF4444</Color>
            <Color x:Key="InfoColor">#3B82F6</Color>
            
            <!-- Border and Divider Colors -->
            <Color x:Key="DividerColor">#E5E7EB</Color>
            <Color x:Key="BorderColor">#D1D5DB</Color>
            <Color x:Key="CardBorderColor">#F3F4F6</Color>
            
            <!-- Card Gradient Colors -->
            <Color x:Key="CardGradientStartColor">#FFFFFF</Color>
            <Color x:Key="CardGradientEndColor">#F8FAFC</Color>

            <!-- KPI Card Colors -->
            <Color x:Key="KPITotalSalesColor">#6366F1</Color>
            <Color x:Key="KPITotalProfitColor">#10B981</Color>
            <Color x:Key="KPIInvoiceCountColor">#F59E0B</Color>
            <Color x:Key="KPIAverageValueColor">#8B5CF6</Color>
            <Color x:Key="KPITotalProductsColor">#06B6D4</Color>
            <Color x:Key="KPILowStockColor">#EF4444</Color>
            
            <!-- Brushes -->
            <SolidColorBrush x:Key="PrimaryBusinessBrush" Color="{StaticResource PrimaryBusinessColor}"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
            <SolidColorBrush x:Key="SecondaryBusinessBrush" Color="{StaticResource SecondaryBusinessColor}"/>
            <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}"/>
            <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}"/>
            <SolidColorBrush x:Key="AccentBusinessBrush" Color="{StaticResource AccentBusinessColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

            <!-- KPI Brushes -->
            <SolidColorBrush x:Key="KPITotalSalesBrush" Color="{StaticResource KPITotalSalesColor}"/>
            <SolidColorBrush x:Key="KPITotalProfitBrush" Color="{StaticResource KPITotalProfitColor}"/>
            <SolidColorBrush x:Key="KPIInvoiceCountBrush" Color="{StaticResource KPIInvoiceCountColor}"/>
            <SolidColorBrush x:Key="KPIAverageValueBrush" Color="{StaticResource KPIAverageValueColor}"/>
            <SolidColorBrush x:Key="KPITotalProductsBrush" Color="{StaticResource KPITotalProductsColor}"/>
            <SolidColorBrush x:Key="KPILowStockBrush" Color="{StaticResource KPILowStockColor}"/>
            
            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource SidebarBackgroundColor}" Offset="0"/>
                <GradientStop Color="{StaticResource SidebarGradientEndColor}" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource CardGradientStartColor}" Offset="0"/>
                <GradientStop Color="{StaticResource CardGradientEndColor}" Offset="1"/>
            </LinearGradientBrush>

            <!-- KPI Card Gradient Brushes -->
            <LinearGradientBrush x:Key="KPITotalSalesGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6366F1" Offset="0"/>
                <GradientStop Color="#818CF8" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="KPITotalProfitGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10B981" Offset="0"/>
                <GradientStop Color="#34D399" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="KPIInvoiceCountGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F59E0B" Offset="0"/>
                <GradientStop Color="#FBBF24" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="KPIAverageValueGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0"/>
                <GradientStop Color="#A78BFA" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="KPITotalProductsGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06B6D4" Offset="0"/>
                <GradientStop Color="#22D3EE" Offset="1"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="KPILowStockGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EF4444" Offset="0"/>
                <GradientStop Color="#F87171" Offset="1"/>
            </LinearGradientBrush>

            <!-- Company Name Main Style (Bold, Larger) -->
            <Style x:Key="CompanyNameStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Company Subtitle Style (Smaller, Lighter) -->
            <Style x:Key="CompanySubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Header Company Name Style (For Dashboard) -->
            <Style x:Key="HeaderCompanyNameStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Header Company Subtitle Style (For Dashboard) -->
            <Style x:Key="HeaderCompanySubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="#B0BEC5"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Login Card Container Style -->
            <Style x:Key="LoginCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="35,30"/>
                <Setter Property="Margin" Value="40,20"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6"/>
                <Setter Property="UniformCornerRadius" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MaxWidth" Value="420"/>
            </Style>

            <!-- Arabic TextBox Style -->
            <Style x:Key="ArabicTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <!-- Arabic Numeric TextBox Style (LTR for numbers) -->
            <Style x:Key="ArabicNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <!-- Arabic Button Style -->
            <Style x:Key="ArabicButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <!-- Arabic Flat Button Style -->
            <Style x:Key="ArabicFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <!-- Arabic Outlined Button Style -->
            <Style x:Key="ArabicOutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <!-- Arabic Danger Button Style -->
            <Style x:Key="ArabicDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="#D32F2F"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
            </Style>

            <!-- Arabic Success Button Style -->
            <Style x:Key="ArabicSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="{StaticResource SecondaryBusinessBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
            </Style>

            <!-- Arabic ComboBox Style -->
            <Style x:Key="ArabicComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <!-- Arabic DataGrid Style -->
            <Style x:Key="ArabicDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
                <Setter Property="RowHeight" Value="40"/>
                <Setter Property="ColumnHeaderHeight" Value="45"/>
            </Style>

            <!-- Arabic DataGrid Header Style -->
            <Style x:Key="ArabicDataGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Padding" Value="10,8"/>
            </Style>

            <!-- Arabic Card Style -->
            <Style x:Key="ArabicCardStyle" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
                <Setter Property="UniformCornerRadius" Value="12"/>
            </Style>

            <!-- ==================== Global RTL Styles ==================== -->
            
            <!-- Default Window Style -->
            <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Default UserControl Style -->
            <Style TargetType="UserControl">
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Arabic TextBlock Style -->
            <Style x:Key="ArabicTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Arabic Header Style -->
            <Style x:Key="ArabicHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Modern Page Header Style -->
            <Style x:Key="ModernPageHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Modern Page SubHeader Style -->
            <Style x:Key="ModernPageSubHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <!-- Arabic SubHeader Style -->
            <Style x:Key="ArabicSubHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <!-- Arabic Label Style -->
            <Style x:Key="ArabicLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <!-- Modern Navigation Button Style -->
            <Style x:Key="ModernNavButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="4,3"/>
                <Setter Property="Foreground" Value="#B0BEC5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FFFFFF15"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Primary Button Style -->
            <Style x:Key="ModernPrimaryButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="24,10"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Secondary Button Style -->
            <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="24,10"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource SecondaryBusinessBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Card Style -->
            <Style x:Key="ModernCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.08" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Dashboard Card Style -->
            <Style x:Key="ModernDashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="24"/>
                <Setter Property="Margin" Value="12"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.1" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- KPI Card Style -->
            <Style x:Key="KPICardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.08" Direction="270"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="5" Opacity="0.15" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Icon Card Style -->
            <Style x:Key="ModernIconCardStyle" TargetType="Border">
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.2" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar Style -->
            <Style x:Key="ModernSidebarStyle" TargetType="Border">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1A2E" Offset="0"/>
                            <GradientStop Color="#16213E" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="CornerRadius" Value="0,20,20,0"/>
            </Style>

            <!-- Navigation Button Style -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Foreground" Value="#B0BEC5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FFFFFF15"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Summary Card Value Style -->
            <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBusinessBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- Summary Card Label Style -->
            <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#757575"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <utilities:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <utilities:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
            <utilities:DecimalToColorConverter x:Key="DecimalToColorConverter"/>
            <utilities:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <utilities:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <utilities:FileSizeConverter x:Key="FileSizeConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
