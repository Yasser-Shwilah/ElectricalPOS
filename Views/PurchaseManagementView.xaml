<UserControl x:Class="ElectricalPOS.Views.PurchaseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:PurchaseViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة المشتريات"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="24"/>
            <TextBlock Text="إنشاء فواتير الشراء وإدارة المدفوعات"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: New Purchase Form -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Supplier & Date -->
                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="فاتورة شراء جديدة"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      materialDesign:HintAssist.Hint="اختر المورد"
                                      materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource ArabicComboBoxStyle}"
                                      ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}"
                                      DisplayMemberPath="Name"
                                      ToolTip="اختر المورد لفاتورة الشراء"
                                      Margin="0,0,5,0"/>

                            <DatePicker Grid.Column="1"
                                        materialDesign:HintAssist.Hint="تاريخ الشراء"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        SelectedDate="{Binding PurchaseDate}"
                                        FontFamily="{StaticResource ArabicFont}"
                                        ToolTip="حدد تاريخ فاتورة الشراء"
                                        Margin="5,5,0,5"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Add Item -->
                <materialDesign:Card Grid.Row="1"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="إضافة صنف"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      materialDesign:HintAssist.Hint="اختر المنتج"
                                      materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource ArabicComboBoxStyle}"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="Name"
                                      ToolTip="اختر المنتج المراد شراؤه"
                                      Margin="0,0,5,0"/>

                            <TextBox Grid.Column="1"
                                     materialDesign:HintAssist.Hint="الكمية"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="حدد الكمية"
                                     Margin="5,0"/>

                            <TextBox Grid.Column="2"
                                     materialDesign:HintAssist.Hint="سعر الوحدة"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding ItemUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                     ToolTip="أدخل سعر الوحدة"
                                     Margin="5,0"/>

                            <Button Grid.Column="3"
                                    Style="{StaticResource ArabicSuccessButtonStyle}"
                                    Command="{Binding AddItemCommand}"
                                    ToolTip="إضافة الصنف للفاتورة"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Purchase Items List -->
                <materialDesign:Card Grid.Row="2"
                                     Style="{StaticResource ArabicCardStyle}">
                    <DockPanel>
                        <TextBlock Text="أصناف الفاتورة"
                                   Style="{StaticResource ArabicSubHeaderStyle}"
                                   DockPanel.Dock="Top"/>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ArabicDataGridStyle}"
                                  ItemsSource="{Binding PurchaseItems}"
                                  ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat=N2}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="حذف" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="إزالة الصنف"
                                                    Padding="4">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#D32F2F"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Totals & Create -->
                <materialDesign:Card Grid.Row="3"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="المبلغ المدفوع:" Style="{StaticResource ArabicLabelStyle}" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ArabicNumericTextBoxStyle}"
                                         Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         ToolTip="أدخل المبلغ المدفوع"
                                         Margin="0,0,15,0"/>

                                <TextBlock Grid.Column="2" Text="الإجمالي:" Style="{StaticResource ArabicLabelStyle}" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat=N2}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="المتبقي (الدين):" Style="{StaticResource ArabicLabelStyle}" FontSize="16" Foreground="#D32F2F"/>
                                <TextBlock Text="{Binding Debt, StringFormat=N2}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#D32F2F"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ArabicSuccessButtonStyle}"
                                    Command="{Binding CreatePurchaseCommand}"
                                    Height="50" FontSize="16"
                                    ToolTip="إنشاء فاتورة الشراء">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,5,0" Width="24" Height="24"/>
                                    <TextBlock Text="إنشاء الفاتورة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ArabicOutlinedButtonStyle}"
                                    Command="{Binding ClearFormCommand}"
                                    ToolTip="مسح النموذج">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Eraser" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="مسح" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Right: Purchase History & Payments -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Purchase History -->
                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource ArabicCardStyle}">
                    <DockPanel>
                        <TextBlock Text="سجل المشتريات"
                                   Style="{StaticResource ArabicSubHeaderStyle}"
                                   DockPanel.Dock="Top"/>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ArabicDataGridStyle}"
                                  ItemsSource="{Binding Purchases}"
                                  SelectedItem="{Binding SelectedPurchase}"
                                  ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=d}" Width="85"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الدين" Binding="{Binding Debt, StringFormat=N2}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Payment Section -->
                <materialDesign:Card Grid.Row="1"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="تسديد دفعة"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="مبلغ الدفعة"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                     ToolTip="أدخل مبلغ الدفعة"
                                     Margin="0,0,5,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ArabicButtonStyle}"
                                    Command="{Binding PayPurchaseCommand}"
                                    ToolTip="تسجيل الدفعة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashCheck" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="دفع" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource ArabicDangerButtonStyle}"
                                Command="{Binding DeletePurchaseCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,10,0,0"
                                ToolTip="حذف فاتورة الشراء المحددة">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="حذف الفاتورة المحددة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
