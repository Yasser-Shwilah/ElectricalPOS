<UserControl x:Class="ElectricalPOS.Views.InventoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="750" d:DesignWidth="1000">

    <UserControl.DataContext>
        <vm:InventoryViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة المخزون"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="24"/>
            <TextBlock Text="مراقبة المخزون وحركات المنتجات وتعديل الكميات"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"/>
        </StackPanel>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Stock Value -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ArabicCardStyle}" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="32" Height="32"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding TotalStockValue, StringFormat=N2}"
                               Style="{StaticResource SummaryValueStyle}"
                               FlowDirection="LeftToRight"/>
                    <TextBlock Text="إجمالي قيمة المخزون"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Products Count -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Package" Width="32" Height="32"
                                             HorizontalAlignment="Center"
                                             Foreground="#4CAF50"/>
                    <TextBlock Text="{Binding TotalProductsQuantity}"
                               Style="{StaticResource SummaryValueStyle}"
                               Foreground="#4CAF50"/>
                    <TextBlock Text="إجمالي عدد المنتجات"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Low Stock Alert -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource ArabicCardStyle}" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircle" Width="32" Height="32"
                                             HorizontalAlignment="Center"
                                             Foreground="#FF9800"/>
                    <TextBlock Text="{Binding LowStockProducts.Count}"
                               Style="{StaticResource SummaryValueStyle}"
                               Foreground="#FF9800"/>
                    <TextBlock Text="منتجات منخفضة المخزون"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Products & Stock Movements -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Products List -->
                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="قائمة المنتجات والمخزون"
                                       Style="{StaticResource ArabicSubHeaderStyle}"
                                       Margin="0"/>
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding LoadProductsCommand}"
                                    ToolTip="تحديث القائمة"
                                    Margin="10,0,0,0" Padding="4">
                                <materialDesign:PackIcon Kind="Refresh"/>
                            </Button>
                        </StackPanel>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ArabicDataGridStyle}"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="100"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Stock Movements -->
                <materialDesign:Card Grid.Row="1"
                                     Style="{StaticResource ArabicCardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="حركات المخزون"
                                       Style="{StaticResource ArabicSubHeaderStyle}"
                                       Margin="0"/>

                            <ComboBox materialDesign:HintAssist.Hint="تصفية حسب النوع"
                                      Style="{StaticResource ArabicComboBoxStyle}"
                                      ItemsSource="{Binding MovementTypes}"
                                      SelectedItem="{Binding SelectedMovementType}"
                                      Width="150"
                                      Margin="15,0,0,0"/>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding FilterMovementsByTypeCommand}"
                                    ToolTip="تصفية الحركات"
                                    Padding="4" Margin="5,0,0,0">
                                <materialDesign:PackIcon Kind="Filter"/>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding ViewProductMovementsCommand}"
                                    ToolTip="عرض حركات المنتج المحدد"
                                    Padding="4" Margin="5,0,0,0">
                                <materialDesign:PackIcon Kind="Eye"/>
                            </Button>
                        </StackPanel>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ArabicDataGridStyle}"
                                  ItemsSource="{Binding StockMovements}"
                                  SelectedItem="{Binding SelectedMovement}"
                                  ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding Product.Name}" Width="*"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="90"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المرجع" Binding="{Binding RelatedDocument}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Right: Adjustment & Low Stock -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stock Adjustment -->
                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="تعديل المخزون"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>

                        <TextBlock Text="{Binding SelectedProduct.Name, StringFormat='المنتج المحدد: {0}', FallbackValue='لم يتم تحديد منتج'}"
                                   FontSize="13" Foreground="#757575" Margin="0,0,0,10"
                                   FontFamily="{StaticResource ArabicFont}"/>

                        <Button Style="{StaticResource ArabicOutlinedButtonStyle}"
                                Command="{Binding StartAdjustmentCommand}"
                                HorizontalAlignment="Stretch"
                                ToolTip="بدء تعديل كمية المخزون"
                                Visibility="{Binding IsAdjustmentMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="بدء التعديل" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding IsAdjustmentMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox materialDesign:HintAssist.Hint="كمية التعديل (+ أو -)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="أدخل كمية التعديل (موجب للإضافة، سالب للخصم)"
                                     Margin="0,5"/>

                            <TextBox materialDesign:HintAssist.Hint="سبب التعديل"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicTextBoxStyle}"
                                     Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="أدخل سبب تعديل المخزون"
                                     Margin="0,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ArabicSuccessButtonStyle}"
                                        Command="{Binding PerformAdjustmentCommand}"
                                        ToolTip="تنفيذ التعديل">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="تنفيذ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ArabicOutlinedButtonStyle}"
                                        Command="{Binding CancelAdjustmentCommand}"
                                        ToolTip="إلغاء التعديل">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,15,0,10"/>

                        <!-- Low Stock Threshold -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="حد المخزون المنخفض"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="حدد الحد الأدنى للمخزون"
                                     Margin="0,0,5,0"/>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ArabicButtonStyle}"
                                    Command="{Binding CheckLowStockCommand}"
                                    ToolTip="فحص المخزون المنخفض">
                                <materialDesign:PackIcon Kind="AlertCircleCheck"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Low Stock Products -->
                <materialDesign:Card Grid.Row="1"
                                     Style="{StaticResource ArabicCardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#FF9800" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="منتجات منخفضة المخزون"
                                       Style="{StaticResource ArabicSubHeaderStyle}"
                                       Foreground="#FF9800"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ArabicDataGridStyle}"
                                  ItemsSource="{Binding LowStockProducts}"
                                  ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
