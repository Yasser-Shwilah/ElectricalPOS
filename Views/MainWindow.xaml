<Window x:Class="ElectricalPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="نظام نقاط البيع الكهربائية - لوحة التحكم"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation -->
            <ColumnDefinition Width="280"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Sidebar Navigation ==================== -->
        <Border Grid.Column="0"
                CornerRadius="0,20,20,0"
                Background="{StaticResource SidebarGradientBrush}">
            <DockPanel>
                <!-- App Header with Company Branding -->
                <StackPanel DockPanel.Dock="Top" Margin="15,35,15,15">
                    <!-- Company Logo/Icon with modern glow effect -->
                    <Border Width="70" Height="70" 
                            CornerRadius="20" 
                            HorizontalAlignment="Center"
                            Background="#6C63FF"
                            Margin="0,0,0,18">
                        <Border.Effect>
                            <DropShadowEffect Color="#6C63FF" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Storefront"
                                                 Width="36" Height="36"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="White"/>
                    </Border>
                    
                    <!-- Company Name -->
                    <TextBlock Text="{StaticResource CompanyName}"
                               Style="{StaticResource HeaderCompanyNameStyle}"
                               TextAlignment="Center"
                               FontSize="15"
                               Margin="0,0,0,6"/>
                    
                    <!-- Subtitle -->
                    <TextBlock Text="{StaticResource CompanySubtitle}"
                               Style="{StaticResource HeaderCompanySubtitleStyle}"
                               TextAlignment="Center"
                               FontSize="11"
                               Margin="0,0,0,20"/>

                    <!-- Welcome Message with modern pill style -->
                    <Border Background="#FFFFFF12"
                            CornerRadius="12"
                            Padding="14,10"
                            Margin="0,0,0,15"
                            BorderBrush="#FFFFFF15"
                            BorderThickness="1">
                        <TextBlock Text="{Binding WelcomeMessage}"
                                   FontSize="12"
                                   Foreground="#B8C5D6"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource ArabicFont}"/>
                    </Border>

                    <Separator Background="#FFFFFF20" Margin="0,5,0,10"/>
                </StackPanel>

                <!-- Logout Button at Bottom -->
                <Button DockPanel.Dock="Bottom"
                        Content="تسجيل الخروج"
                        Command="{Binding LogoutCommand}"
                        Margin="15,10,15,25"
                        Height="48"
                        FontFamily="{StaticResource ArabicFont}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#FF6B6B"
                        ToolTip="تسجيل الخروج من النظام">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF6B6B" BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF8A8A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Navigation Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0">
                    <StackPanel>
                        <!-- المبيعات -->
                        <Button Command="{Binding ShowSalesCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة المبيعات والفواتير"
                                Visibility="{Binding CanShowSales, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المبيعات" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CashRegister" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- المشتريات -->
                        <Button Command="{Binding ShowPurchasesCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة المشتريات وفواتير الشراء"
                                Visibility="{Binding CanShowPurchases, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المشتريات" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Cart" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- المنتجات -->
                        <Button Command="{Binding ShowProductsCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة المنتجات والأصناف"
                                Visibility="{Binding CanShowProducts, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المنتجات" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Package" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- المخزون -->
                        <Button Command="{Binding ShowInventoryCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة المخزون وحركات المخزون"
                                Visibility="{Binding CanShowInventory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المخزون" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Warehouse" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الجرد -->
                        <Button Command="{Binding ShowStockAuditCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="الجرد الشامل للمخزون والصندوق"
                                Visibility="{Binding CanShowStockAudit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الجرد" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ClipboardCheck" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الموردون (Admin Only) -->
                        <Button Command="{Binding ShowSuppliersCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة الموردين وحساباتهم"
                                Visibility="{Binding CanShowSuppliers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الموردون" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="TruckDelivery" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- العملاء (Admin Only) -->
                        <Button Command="{Binding ShowCustomersCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة العملاء وحساباتهم"
                                Visibility="{Binding CanShowCustomers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="العملاء" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="AccountGroup" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الصندوق -->
                        <Button Command="{Binding ShowCashCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة الصندوق والإيرادات"
                                Visibility="{Binding CanShowCash, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الصندوق" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CashMultiple" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الفواتير -->
                        <Button Command="{Binding ShowInvoicesCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="استعراض الفواتير"
                                Visibility="{Binding CanShowInvoices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الفواتير" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="FileDocument" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- الإحصائيات -->
                        <Button Command="{Binding ShowStatisticsCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="لوحة الإحصائيات والمراقبة"
                                Visibility="{Binding CanShowStatistics, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الإحصائيات" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ChartBar" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>


                        <!-- التصنيفات (Admin Only) -->
                        <Button Command="{Binding ShowCategoriesCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة التصنيفات"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="التصنيفات" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="TagMultiple" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- المستخدمون (Admin Only) -->
                        <Button Command="{Binding ShowUsersCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="إدارة المستخدمين والصلاحيات"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="المستخدمون" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="AccountCog" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- النسخ الاحتياطي (Admin Only) -->
                        <Button Command="{Binding ShowBackupCommand}"
                                Margin="0,2" Height="48"
                                HorizontalContentAlignment="Right"
                                ToolTip="النسخ الاحتياطي واستعادة البيانات"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ModernNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="النسخ الاحتياطي" Foreground="White" FontFamily="{StaticResource ArabicFont}" FontSize="14" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="CloudUpload" Foreground="White" Margin="10,0,0,0" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== Main Content Area ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <!-- Background Pattern -->
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F5F7FA" Offset="0"/>
                        <GradientStop Color="#E8ECF1" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            
            <!-- Dynamic Content -->
            <ContentControl Content="{Binding CurrentView}" Margin="10"/>
        </Grid>
    </Grid>
</Window>
