<UserControl x:Class="ElectricalPOS.Views.StockAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.DataContext>
        <vm:StockAuditViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="الجرد الشامل"
                           Style="{StaticResource ArabicHeaderStyle}"
                           FontSize="26"/>
                <TextBlock Text="تقرير شامل عن المخزون والصندوق وحساب إجمالي قيمة المتجر"
                           Style="{StaticResource ArabicTextStyle}"
                           Foreground="#757575"/>
            </StackPanel>
            
            <!-- Perform Audit Button -->
            <Button Grid.Column="1"
                    Style="{StaticResource ArabicSuccessButtonStyle}"
                    Command="{Binding PerformAuditCommand}"
                    Height="45" Padding="20,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClipboardCheck" VerticalAlignment="Center" Margin="0,0,8,0" Width="22" Height="22"/>
                    <TextBlock Text="تنفيذ الجرد" VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Summary Cards - Main Metrics -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Products Count -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ArabicCardStyle}" Margin="0,0,5,0">
                <Border BorderBrush="#6C63FF" BorderThickness="0,4,0,0" CornerRadius="0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                        <materialDesign:PackIcon Kind="PackageVariant" Width="36" Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#6C63FF"/>
                        <TextBlock Text="{Binding TotalProductsCount}"
                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#6C63FF" Margin="0,5,0,0"/>
                        <TextBlock Text="عدد الأصناف"
                                   Style="{StaticResource SummaryLabelStyle}"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- Total Products Quantity -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <Border BorderBrush="#4CAF50" BorderThickness="0,4,0,0" CornerRadius="0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                        <materialDesign:PackIcon Kind="Counter" Width="36" Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#4CAF50"/>
                        <TextBlock Text="{Binding TotalProductsQuantity, StringFormat=N0}"
                                   FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#4CAF50" Margin="0,5,0,0"/>
                        <TextBlock Text="إجمالي الكمية"
                                   Style="{StaticResource SummaryLabelStyle}"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- Total Inventory Value at Selling Price -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <Border BorderBrush="#FF9800" BorderThickness="0,4,0,0" CornerRadius="0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="36" Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#FF9800"/>
                        <TextBlock Text="{Binding TotalInventoryValueAtSelling, StringFormat=N2}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#FF9800" Margin="0,5,0,0"
                                   FlowDirection="LeftToRight"/>
                        <TextBlock Text="قيمة المخزون (سعر البيع)"
                                   Style="{StaticResource SummaryLabelStyle}"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>

            <!-- Cash Balance -->
            <materialDesign:Card Grid.Column="3" Style="{StaticResource ArabicCardStyle}" Margin="5,0,0,0">
                <Border BorderBrush="#E91E63" BorderThickness="0,4,0,0" CornerRadius="0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10">
                        <materialDesign:PackIcon Kind="Cash" Width="36" Height="36"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#E91E63"/>
                        <TextBlock Text="{Binding CurrentCashBalance, StringFormat=N2}"
                                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="#E91E63" Margin="0,5,0,0"
                                   FlowDirection="LeftToRight"/>
                        <TextBlock Text="رصيد الصندوق"
                                   Style="{StaticResource SummaryLabelStyle}"/>
                    </StackPanel>
                </Border>
            </materialDesign:Card>
        </Grid>

        <!-- Secondary Metrics -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Value at Cost -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ArabicCardStyle}" Margin="0,0,5,0">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <materialDesign:PackIcon Kind="Calculator" Width="28" Height="28"
                                             VerticalAlignment="Center"
                                             Foreground="#607D8B" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="قيمة المخزون (سعر التكلفة)"
                                   Style="{StaticResource SummaryLabelStyle}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalInventoryValueAtCost, StringFormat=N2}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#607D8B" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Expected Profit -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <materialDesign:PackIcon Kind="TrendingUp" Width="28" Height="28"
                                             VerticalAlignment="Center"
                                             Foreground="#8BC34A" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="الربح المتوقع"
                                   Style="{StaticResource SummaryLabelStyle}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalExpectedProfit, StringFormat=N2}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#8BC34A" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Total Assets -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource ArabicCardStyle}" Margin="5,0,0,0">
                <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountBalance" Width="32" Height="32"
                                                 VerticalAlignment="Center"
                                                 Foreground="White" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="إجمالي أصول المتجر"
                                       Foreground="White" FontSize="12"/>
                            <TextBlock Text="{Binding TotalAssets, StringFormat=N2}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="White" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:Card>
        </Grid>

        <!-- Main Content - Details -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Products List -->
            <materialDesign:Card Style="{StaticResource ArabicCardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="تفاصيل المنتجات"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>
                    </StackPanel>

                    <DataGrid DockPanel.Dock="Bottom"
                              Style="{StaticResource ArabicDataGridStyle}"
                              ItemsSource="{Binding Products}"
                              ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#6C63FF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="100"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="القيمة $" Width="100">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0:N2}">
                                        <Binding Path="Quantity"/>
                                        <Binding Path="SalePrice"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF9800"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Footer Actions -->
        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Audit Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="تاريخ الجرد: "
                           VerticalAlignment="Center" FontWeight="SemiBold"
                           Visibility="{Binding HasPerformedAudit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding PerformedAuditDate, StringFormat=g}"
                           VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="#757575"
                           Visibility="{Binding HasPerformedAudit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ArabicSuccessButtonStyle}"
                        Command="{Binding PrintAuditReportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExport" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="تصدير تقرير" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="5" Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="50" Height="50"/>
                <TextBlock Text="جاري تحميل البيانات..." Foreground="White"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
