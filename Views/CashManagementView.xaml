<UserControl x:Class="ElectricalPOS.Views.CashManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.DataContext>
        <vm:CashViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة الصندوق"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="24"/>
            <TextBlock Text="إدارة الإيرادات والمصروفات ومتابعة الرصيد"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"/>
        </StackPanel>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Current Balance -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ArabicCardStyle}" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Wallet" Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}"
                               Style="{StaticResource SummaryValueStyle}"
                               FlowDirection="LeftToRight"
                               FontSize="20"/>
                    <TextBlock Text="الرصيد الحالي"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Today Expenses -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CalendarToday" Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="#2196F3"/>
                    <TextBlock Text="{Binding TodayExpense, StringFormat=N2}"
                               Style="{StaticResource SummaryValueStyle}"
                               Foreground="#2196F3"
                               FlowDirection="LeftToRight"
                               FontSize="20"/>
                    <TextBlock Text="مصروفات اليوم"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>

