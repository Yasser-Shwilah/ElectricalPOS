            <!-- Today Income -->
            <materialDesign:Card Grid.Column="4" Style="{StaticResource ArabicCardStyle}" Margin="5,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CalendarToday" Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="#2196F3"/>
                    <TextBlock Text="{Binding TodayIncome, StringFormat=N2}"
                               Style="{StaticResource SummaryValueStyle}"
                               Foreground="#2196F3"
                               FlowDirection="LeftToRight"
