                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Month Expenses -->
            <materialDesign:Card Grid.Column="5" Style="{StaticResource ArabicCardStyle}" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CalendarMonth" Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="#9C27B0"/>
                    <TextBlock Text="{Binding MonthExpense, StringFormat=N2}"
                               Style="{StaticResource SummaryValueStyle}"
                               Foreground="#9C27B0"
                               FlowDirection="LeftToRight"
                               FontSize="20"/>
                    <TextBlock Text="مصروفات الشهر"
                               Style="{StaticResource SummaryLabelStyle}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Add Transaction Form -->
        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource ArabicCardStyle}"
                             Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="إضافة حركة مالية"
                           Style="{StaticResource ArabicSubHeaderStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              materialDesign:HintAssist.Hint="نوع الحركة"
                              materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource ArabicComboBoxStyle}"
                              ItemsSource="{Binding TransactionTypes}"
                              SelectedItem="{Binding TransactionType}"
                              ToolTip="اختر نوع الحركة المالية"
                              Margin="0,0,5,0"/>

                    <TextBox Grid.Column="1"
                             materialDesign:HintAssist.Hint="المبلغ"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource ArabicNumericTextBoxStyle}"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             ToolTip="أدخل المبلغ"
                             Margin="5,0"/>

                    <TextBox Grid.Column="2"
                             materialDesign:HintAssist.Hint="الوصف"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource ArabicTextBoxStyle}"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="أدخل وصف الحركة المالية"
                             Margin="5,0"/>

                    <DatePicker Grid.Column="3"
                                materialDesign:HintAssist.Hint="التاريخ"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding TransactionDate}"
                                FontFamily="{StaticResource ArabicFont}"
                                ToolTip="حدد تاريخ الحركة"
                                Margin="5,5,5,5"/>

                    <Button Grid.Column="4"
                            Style="{StaticResource ArabicSuccessButtonStyle}"
                            Command="{Binding AddTransactionCommand}"
                            ToolTip="إضافة الحركة المالية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Transactions List -->
        <materialDesign:Card Grid.Row="3"
                             Style="{StaticResource ArabicCardStyle}">
            <DockPanel>
                <!-- Filter Bar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="سجل الحركات المالية"
                               Style="{StaticResource ArabicSubHeaderStyle}"
                               Margin="0,0,15,0"/>

                    <DatePicker materialDesign:HintAssist.Hint="من تاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding FilterStartDate}"
                                FontFamily="{StaticResource ArabicFont}"
                                Width="140" Margin="0,0,5,0"/>

                    <DatePicker materialDesign:HintAssist.Hint="إلى تاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding FilterEndDate}"
                                FontFamily="{StaticResource ArabicFont}"
                                Width="140" Margin="5,0"/>

                    <Button Style="{StaticResource ArabicButtonStyle}"
                            Command="{Binding FilterByDateRangeCommand}"
                            ToolTip="تصفية حسب التاريخ"
                            Height="36" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Filter" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="تصفية" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ArabicFlatButtonStyle}"
                            Command="{Binding ShowTodayTransactionsCommand}"
                            ToolTip="عرض حركات اليوم"
                            Height="36">
                        <TextBlock Text="اليوم" VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource ArabicFlatButtonStyle}"
                            Command="{Binding ShowAllTransactionsCommand}"
                            ToolTip="عرض جميع الحركات"
                            Height="36">
                        <TextBlock Text="الكل" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <DataGrid DockPanel.Dock="Bottom"
                          Style="{StaticResource ArabicDataGridStyle}"
                          ItemsSource="{Binding CashTransactions}"
                          SelectedItem="{Binding SelectedTransaction}"
                          ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=g}" Width="150"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding DataContext.DeleteTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="حذف الحركة"
                                            Padding="4">
                                        <materialDesign:PackIcon Kind="Delete" Foreground="#D32F2F"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
