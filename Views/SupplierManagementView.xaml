<UserControl x:Class="ElectricalPOS.Views.SupplierManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:SupplierViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إدارة الموردين"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="24"/>
            <TextBlock Text="إضافة وتعديل وحذف الموردين وعرض حساباتهم"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"/>
        </StackPanel>

        <!-- Form Section -->
        <materialDesign:Card Grid.Row="1"
                             Style="{StaticResource ArabicCardStyle}"
                             Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="{Binding IsEditMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='تعديل بيانات المورد|إضافة مورد جديد'}"
                           Style="{StaticResource ArabicSubHeaderStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="اسم المورد"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource ArabicTextBoxStyle}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="أدخل اسم المورد"
                             Margin="0,0,5,0"/>

                    <TextBox Grid.Column="1"
                             materialDesign:HintAssist.Hint="معلومات الاتصال (هاتف / عنوان)"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource ArabicTextBoxStyle}"
                             Text="{Binding ContactInfo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="أدخل رقم الهاتف أو العنوان"
                             Margin="5,0,0,0"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,15,0,0">
                    <Button Style="{StaticResource ArabicSuccessButtonStyle}"
                            Command="{Binding AddSupplierCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            ToolTip="إضافة مورد جديد">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ArabicButtonStyle}"
                            Command="{Binding UpdateSupplierCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="تحديث بيانات المورد">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ArabicOutlinedButtonStyle}"
                            Command="{Binding ClearFormCommand}"
                            ToolTip="مسح النموذج">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eraser" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Suppliers List -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource ArabicCardStyle}"
                                 Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock Text="قائمة الموردين"
                               Style="{StaticResource ArabicSubHeaderStyle}"
                               DockPanel.Dock="Top"/>

                    <DataGrid DockPanel.Dock="Bottom"
                              Style="{StaticResource ArabicDataGridStyle}"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="معلومات الاتصال" Binding="{Binding ContactInfo}" Width="150"/>
                            <DataGridTextColumn Header="إجمالي الدين" Binding="{Binding TotalDebt, StringFormat=N2}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="إجراءات" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    ToolTip="تعديل المورد"
                                                    Padding="4" Margin="2,0">
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.ViewSupplierAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    ToolTip="عرض حساب المورد"
                                                    Padding="4" Margin="2,0">
                                                <materialDesign:PackIcon Kind="Eye" Foreground="#4CAF50"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    ToolTip="حذف المورد"
                                                    Padding="4" Margin="2,0">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#D32F2F"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>

            <!-- Supplier Account Details -->
            <materialDesign:Card Grid.Column="1"
                                 Style="{StaticResource ArabicCardStyle}"
                                 Visibility="{Binding IsViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="حساب المورد"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>

                        <Border Background="#FFF3E0" CornerRadius="8" Padding="12,8" Margin="0,5,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي الدين:" Style="{StaticResource ArabicLabelStyle}" FontSize="16"/>
                                <TextBlock Text="{Binding TotalDebt, StringFormat=N2}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#D32F2F"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="فواتير الشراء"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#757575"
                                   FontFamily="{StaticResource ArabicFont}"/>
                    </StackPanel>

                    <DataGrid DockPanel.Dock="Bottom"
                              Style="{StaticResource ArabicDataGridStyle}"
                              ItemsSource="{Binding SupplierPurchases}"
                              ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat=N2}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الدين" Binding="{Binding Debt, StringFormat=N2}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
