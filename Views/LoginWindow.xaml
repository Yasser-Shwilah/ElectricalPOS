<Window x:Class="ElectricalPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="تسجيل الدخول - مركز الحاج حساني"
        Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ArabicFont}"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- Modern Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#16213E" Offset="0.5"/>
                <GradientStop Color="#0F3460" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <!-- Decorative circles -->
        <Ellipse Width="300" Height="300" Fill="#6C63FF10" 
                 HorizontalAlignment="Left" VerticalAlignment="Top" 
                 Margin="-100,-100,0,0"/>
        <Ellipse Width="200" Height="200" Fill="#00D9C010" 
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                 Margin="0,0,-50,-50"/>
        
        <!-- Login Card -->
        <materialDesign:Card Style="{StaticResource LoginCardStyle}" 
                             MaxWidth="450"
                             VerticalAlignment="Center">
            <materialDesign:Card.Effect>
                <DropShadowEffect Color="#1A1A2E" BlurRadius="40" ShadowDepth="10" Opacity="0.2" Direction="270"/>
            </materialDesign:Card.Effect>
            <StackPanel>
                <!-- Company Branding with modern icon -->
                <StackPanel Margin="0,15,0,35">
                    <!-- Company Icon with glow -->
                    <Border Width="80" Height="80" 
                            CornerRadius="22" 
                            HorizontalAlignment="Center"
                            Background="#6C63FF"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#6C63FF" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Storefront"
                                                 Width="40" Height="40"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="White"/>
                    </Border>
                    
                    <!-- Company Name -->
                    <TextBlock Text="{StaticResource CompanyName}"
                               Style="{StaticResource CompanyNameStyle}"
                               FontSize="18"
                               Margin="0,0,0,10"/>
                    
                    <!-- Subtitle -->
                    <TextBlock Text="{StaticResource CompanySubtitle}"
                               Style="{StaticResource CompanySubtitleStyle}"
                               FontSize="14"/>
                </StackPanel>

                <!-- Divider -->
                <Separator Background="{StaticResource DividerBrush}" 
                           Margin="0,0,0,25"/>

                <!-- Login Subtitle -->
                <TextBlock Text="تسجيل الدخول إلى حسابك"
                           Style="{StaticResource ArabicTextStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14"
                           Margin="0,0,0,25"/>

                <!-- Username Field -->
                <TextBox materialDesign:HintAssist.Hint="اسم المستخدم"
                         materialDesign:HintAssist.IsFloating="True"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Account"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontFamily="{StaticResource ArabicFont}"
                         FontSize="14"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="أدخل اسم المستخدم الخاص بك"
                         Margin="0,0,0,15"/>

                <!-- Password Field -->
                <PasswordBox materialDesign:HintAssist.Hint="كلمة المرور"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Lock"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             FontFamily="{StaticResource ArabicFont}"
                             FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             ToolTip="أدخل كلمة المرور الخاصة بك"
                             Margin="0,0,0,10"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           FontFamily="{StaticResource ArabicFont}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,5,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                <!-- Login Button -->
                <Button Content="تسجيل الدخول"
                        Style="{StaticResource ArabicButtonStyle}"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        Height="50"
                        FontSize="16"
                        Margin="0,15,0,20"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        Background="#6C63FF"
                        Foreground="White"
                        ToolTip="اضغط لتسجيل الدخول">
                    <Button.Effect>
                        <DropShadowEffect Color="#6C63FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
                    </Button.Effect>
                </Button>

                <!-- Forgot Password Link -->
                <Button Content="هل نسيت كلمة المرور؟"
                        Style="{StaticResource ArabicFlatButtonStyle}"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                        FontSize="13"
                        ToolTip="استعادة كلمة المرور"/>

                <!-- Footer -->
                <TextBlock Text="© ٢٠٢٦ نظام نقاط البيع الكهربائية"
                           Style="{StaticResource ArabicTextStyle}"
                           HorizontalAlignment="Center"
                           Foreground="#9E9E9E"
                           FontSize="11"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
