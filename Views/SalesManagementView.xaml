<UserControl x:Class="ElectricalPOS.Views.SalesManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="نقطة البيع - إصدار الفواتير"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="26"/>
            <TextBlock Text="إنشاء فواتير بيع وإدارة عمليات البيع"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- Left: Product Selection & Cart -->
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Product Selection -->
                <materialDesign:Card Grid.Row="0"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="إضافة منتج للسلة"
                                   Style="{StaticResource ArabicSubHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      materialDesign:HintAssist.Hint="اختر المنتج"
                                      materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource ArabicComboBoxStyle}"
                                      ItemsSource="{Binding FilteredProducts}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      IsDropDownOpen="{Binding IsProductDropDownOpen, Mode=TwoWay}"
                                      ToolTip="اختر المنتج المراد بيعه"
                                      Margin="0,0,5,0"/>

                            <TextBox Grid.Column="1"
                                     materialDesign:HintAssist.Hint="الكمية"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource ArabicNumericTextBoxStyle}"
                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="حدد الكمية المطلوبة"
                                     Margin="5,0"/>

                            <Button Grid.Column="2"
                                    Style="{StaticResource ArabicSuccessButtonStyle}"
                                    Command="{Binding AddToCartCommand}"
                                    ToolTip="إضافة المنتج إلى سلة المبيعات"
                                    Padding="15,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CartPlus" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="إضافة للسلة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Customer Info -->
                <materialDesign:Card Grid.Row="1"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 materialDesign:HintAssist.Hint="اسم الزبون (اختياري)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource ArabicTextBoxStyle}"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="أدخل اسم الزبون"
                                 Margin="0,0,5,0"/>

                        <TextBox Grid.Column="1"
                                 materialDesign:HintAssist.Hint="رقم الهاتف (اختياري)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource ArabicTextBoxStyle}"
                                 Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="أدخل رقم هاتف الزبون"
                                 Margin="5,0,0,0"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Cart Items with Editable Fields -->
                <materialDesign:Card Grid.Row="2"
                                     Style="{StaticResource ArabicCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="سلة المشتريات"
                                       Style="{StaticResource ArabicSubHeaderStyle}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid Style="{StaticResource ArabicDataGridStyle}"
                                      ItemsSource="{Binding CartItems}"
                                      ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      SelectionMode="Single"
                                      ColumnWidth="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="م"
                                                    Binding="{Binding ProductId}"
                                                    Width="50"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                
                                <DataGridTextColumn Header="اسم المادة"
                                                    Binding="{Binding ProductName}"
                                                    Width="150"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Editable Quantity Column -->
                                <DataGridTemplateColumn Header="الكمية" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Quantity}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Center"
                                                     Style="{StaticResource MaterialDesignTextBox}"
                                                     PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Editable Unit Price Column -->
                                <DataGridTemplateColumn Header="السعر" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=N2}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                     HorizontalContentAlignment="Left"
                                                     FlowDirection="LeftToRight"
                                                     Style="{StaticResource MaterialDesignTextBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الإجمالي"
                                                    Binding="{Binding TotalPrice, StringFormat=N2}"
                                                    Width="80"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="المخزون" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AvailableStock}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#757575"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="حذف المنتج"
                                                    Padding="4"
                                                    Margin="2"
                                                    Width="44" Height="36"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#D32F2F" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>

                <!-- Totals & Actions -->
                <materialDesign:Card Grid.Row="3"
                                     Style="{StaticResource ArabicCardStyle}"
                                     Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="الخصم:" 
                                           Style="{StaticResource ArabicLabelStyle}" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         materialDesign:HintAssist.Hint="قيمة الخصم"
                                         Style="{StaticResource ArabicNumericTextBoxStyle}"
                                         Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         ToolTip="أدخل قيمة الخصم"
                                         Margin="0,0,15,0"/>

                                <TextBlock Grid.Column="2" Text="المجموع الكلي:" 
                                           Style="{StaticResource ArabicLabelStyle}" 
                                           FontSize="16" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding TotalAmount, StringFormat=N2}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="الصافي المطلوب:" 
                                           Style="{StaticResource ArabicLabelStyle}" 
                                           FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FinalAmount, StringFormat=N2}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#388E3C"
                                           VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"
                                           Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ArabicSuccessButtonStyle}"
                                    Command="{Binding CompleteSaleCommand}"
                                    Height="55" FontSize="16"
                                    Padding="20,10"
                                    ToolTip="إتمام عملية البيع وإصدار الفاتورة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ReceiptTextPlus" VerticalAlignment="Center" Margin="0,0,8,0" Width="24" Height="24"/>
                                    <TextBlock Text="إتمام البيع" VerticalAlignment="Center" FontSize="16"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ArabicOutlinedButtonStyle}"
                                    Command="{Binding ClearCartCommand}"
                                    Height="55"
                                    Margin="10,0,0,0"
                                    ToolTip="مسح السلة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CartRemove" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="مسح السلة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="PrintInvoiceButton_Click"
                                    Height="55"
                                    Margin="10,0,0,0"
                                    ToolTip="طباعة الفاتورة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="طباعة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="50" Height="50"/>
                <TextBlock Text="جاري معالجة البيانات..." 
                           Foreground="White" 
                           FontSize="16" 
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
