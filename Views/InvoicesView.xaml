<UserControl x:Class="ElectricalPOS.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ElectricalPOS.ViewModels"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:InvoicesViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="الفواتير"
                       Style="{StaticResource ArabicHeaderStyle}"
                       FontSize="24"/>
            <TextBlock Text="استعراض وإدارة فواتير المبيعات"
                       Style="{StaticResource ArabicTextStyle}"
                       Foreground="#757575"
                       FontSize="14"/>
        </StackPanel>

        <!-- Search Section -->
        <materialDesign:Card Grid.Row="1"
                             Style="{StaticResource ArabicCardStyle}"
                             Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         materialDesign:HintAssist.Hint="ابحث برقم الفاتورة"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource ArabicTextBoxStyle}"
                         Text="{Binding SearchInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="أدخل رقم الفاتورة للبحث"
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Style="{StaticResource ArabicSuccessButtonStyle}"
                        Command="{Binding SearchInvoiceCommand}"
                        ToolTip="بحث عن فاتورة"
                        Padding="15,8"
                        Margin="0,0,5,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="بحث" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource ArabicOutlinedButtonStyle}"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip="مسح البحث وعرض الكل"
                        Padding="15,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="إظهار الكل" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Invoices DataGrid -->
        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource ArabicCardStyle}">
            <DockPanel>
                <TextBlock Text="سجل الفواتير"
                           Style="{StaticResource ArabicSubHeaderStyle}"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,10"/>

                <DataGrid DockPanel.Dock="Bottom"
                          Style="{StaticResource ArabicDataGridStyle}"
                          ItemsSource="{Binding PaginatedSales}"
                          SelectedItem="{Binding SelectedInvoice}"
                          ColumnHeaderStyle="{StaticResource ArabicDataGridHeaderStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=d}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الوقت" Binding="{Binding Date, StringFormat=HH:mm}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="اسم الزبون" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, StringFormat=N2}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="طباعة الفاتورة"
                                                Padding="4" Margin="2,0">
                                            <materialDesign:PackIcon Kind="Printer" Foreground="#1976D2"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.ExportToPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="تصدير كملف PDF"
                                                Padding="4" Margin="2,0">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#D32F2F"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3"
                             Style="{StaticResource ArabicCardStyle}"
                             Margin="0,15,0,0"
                             Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- First and Previous -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding FirstPageCommand}"
                            ToolTip="الصفحة الأولى"
                            Padding="8,4">
                        <materialDesign:PackIcon Kind="PageFirst"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding PreviousPageCommand}"
                            ToolTip="الصفحة السابقة"
                            Padding="8,4">
                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                    </Button>
                </StackPanel>

                <!-- Page Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="صفحة"
                               Style="{StaticResource ArabicTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CurrentPage}"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="من"
                               Style="{StaticResource ArabicTextStyle}"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                    <TextBlock Text="{Binding TotalPages}"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="|"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                    <TextBlock Text="إجمالي الفواتير:"
                               Style="{StaticResource ArabicTextStyle}"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"/>
                    <TextBlock Text="{Binding TotalInvoices}"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Next and Last -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding NextPageCommand}"
                            ToolTip="الصفحة التالية"
                            Padding="8,4">
                        <materialDesign:PackIcon Kind="ChevronRight"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding LastPageCommand}"
                            ToolTip="الصفحة الأخيرة"
                            Padding="8,4">
                        <materialDesign:PackIcon Kind="PageLast"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="50" Height="50"/>
                <TextBlock Text="جاري معالجة البيانات..." 
                           Foreground="White" 
                           FontSize="16" 
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
