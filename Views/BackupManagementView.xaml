<UserControl x:Class="ElectricalPOS.Views.BackupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource ArabicFont}">

    <UserControl.Resources>
        <!-- Custom Styles -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00000015" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="White" CornerRadius="15" Padding="25" Margin="10,10,10,5">
            <Border.Effect>
                <DropShadowEffect Color="#00000010" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="النسخ الاحتياطي واستعادة البيانات"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#2D3748"/>
                    <TextBlock Text="إدارة النسخ الاحتياطية وحماية بياناتك"
                               FontSize="13"
                               Foreground="#718096"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Backup Button -->
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding CreateBackupCommand}"
                            Background="#6C63FF"
                            Foreground="White"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding IsBackupInProgress, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowUp" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="إنشاء نسخة احتياطية" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restore Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreFromFileCommand}"
                            BorderBrush="#FF6B6B"
                            Foreground="#FF6B6B"
                            IsEnabled="{Binding IsRestoreInProgress, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowDown" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="استعادة من ملف" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Cards -->
        <Grid Grid.Row="1" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Backups -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <Grid>
                        <Border Width="45" Height="45" CornerRadius="12" Background="#E8E6FF" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Database" Width="24" Height="24" 
                                                     Foreground="#6C63FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalBackups}" FontSize="32" FontWeight="Bold" Foreground="#2D3748" Margin="0,15,0,5"/>
                    <TextBlock Text="إجمالي النسخ الاحتياطية" FontSize="13" Foreground="#718096"/>
                </StackPanel>
            </Border>

            <!-- Total Size -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <Grid>
                        <Border Width="45" Height="45" CornerRadius="12" Background="#E6FFF0" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="Harddisk" Width="24" Height="24" 
                                                     Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalSize}" FontSize="32" FontWeight="Bold" Foreground="#2D3748" Margin="0,15,0,5"/>
                    <TextBlock Text="الحجم الإجمالي" FontSize="13" Foreground="#718096"/>
                </StackPanel>
            </Border>

            <!-- Last Backup -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <Grid>
                        <Border Width="45" Height="45" CornerRadius="12" Background="#FFF5E6" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24" 
                                                     Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding LastBackupDate}" FontSize="20" FontWeight="Bold" Foreground="#2D3748" Margin="0,15,0,5"/>
                    <TextBlock Text="آخر نسخة احتياطية" FontSize="13" Foreground="#718096"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings and Backup History -->
        <Grid Grid.Row="2" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings Panel -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="إعدادات النسخ الاحتياطي"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"
                               Margin="0,0,0,20"/>

                    <!-- Backup Folder -->
                    <TextBlock Text="مجلد النسخ الاحتياطي" FontSize="13" Foreground="#718096" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="مسار المجلد"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="True"
                                 FontFamily="{StaticResource ArabicFont}"/>
                        <Button Grid.Column="1"
                                Command="{Binding BrowseBackupFolderCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="تصفح"
                                Margin="5,0,0,0">
                            <materialDesign:PackIcon Kind="FolderOpen" Foreground="#6C63FF"/>
                        </Button>
                    </Grid>

                    <!-- Open Folder Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenBackupFolderCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderArrowRight" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="فتح المجلد" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,0,0,20"/>

                    <!-- Compression Option -->
                    <CheckBox Content="ضغط الملفات (ZIP)"
                              IsChecked="{Binding CompressBackup}"
                              FontFamily="{StaticResource ArabicFont}"
                              FontSize="14"
                              Foreground="#2D3748"
                              Margin="0,0,0,20"/>

                    <!-- Cleanup Settings -->
                    <TextBlock Text="تنظيف النسخ الاحتياطية القديمة" FontSize="13" Foreground="#718096" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="عدد الأيام"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontFamily="{StaticResource ArabicFont}"/>
                        <TextBlock Grid.Column="1" Text="يوم" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#718096"/>
                    </Grid>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CleanupOldBackupsCommand}"
                            BorderBrush="#F59E0B"
                            Foreground="#F59E0B"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="تنظيف النسخ القديمة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

            <!-- Backup History -->
            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="سجل النسخ الاحتياطية"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="تحديث">
                            <materialDesign:PackIcon Kind="Refresh" Foreground="#6C63FF"/>
                        </Button>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              FontFamily="{StaticResource ArabicFont}"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="الحجم" Binding="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Width="100"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding BackupType}" Width="80"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="130"/>
                            <DataGridTextColumn Header="بواسطة" Binding="{Binding CreatedBy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="3" Background="White" CornerRadius="15" Padding="20" Margin="10,5,10,10">
            <Border.Effect>
                <DropShadowEffect Color="#00000010" BlurRadius="15" ShadowDepth="3" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Information" Foreground="#6C63FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#718096" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress and Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Progress -->
                    <ProgressBar Value="{Binding ProgressValue}"
                                 Width="150"
                                 Height="8"
                                 Margin="0,0,15,0"
                                 Visibility="{Binding IsBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="#6C63FF"/>

                    <!-- Delete Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteBackupCommand}"
                            BorderBrush="#FF6B6B"
                            Foreground="#FF6B6B"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="حذف" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Verify Button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding VerifyBackupCommand}"
                            BorderBrush="#10B981"
                            Foreground="#10B981"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="تحقق" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restore Selected Button -->
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding RestoreBackupCommand}"
                            Background="#10B981"
                            Foreground="White"
                            IsEnabled="{Binding IsRestoreInProgress, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseRefresh" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="استعادة محددة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4"
                Background="#80000000"
                CornerRadius="15"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="50"
                             Height="50"
                             Foreground="White"/>
                <TextBlock Text="جاري التحميل..."
                           Foreground="White"
                           FontSize="14"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
